PROOFHUB_BASE_URL=https://yourcompany.proofhub.com
PROOFHUB_API_KEY=YOUR_API_KEY
# Required format: AppName (email) — ProofHub returns 400 without it
PROOFHUB_USER_AGENT=proofhub-mcp (you@example.com)
PROOFHUB_PROJECT_ID=8213786200
# Maintainable todolists: comma-separated allowlist within the project above.
# The legacy single PROOFHUB_TODOLIST_ID still works as a one-element allowlist.
PROOFHUB_TODOLIST_IDS=271478716253,271478716254
# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
